# Virtual environments
.venv/
venv/
env/
ENV/

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.ipynb_checkpoints/

# Local secrets and environment files
.env
.env.*
!.env.example

# Large local LLM weights — never commit these
# Track only models/README.md and models/.gitkeep. Ignore GGUF files,
# Chrome/Edge leftovers (.crdownload), and any other drop in this folder.
# Packaging still copies models/ from the local disk at assemble time.
models/*
!models/.gitkeep
!models/README.md
*.gguf
*.bin
*.ggml
*.crdownload
*.part
*.incomplete

# User uploads and generated artifacts
data/uploads/*
!data/uploads/.gitkeep
outputs/*
!outputs/.gitkeep

# Local conversation library (SQLite)
data/chats/*
!data/chats/.gitkeep
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Local GGUF eval transcripts (pasted chats). Keep README + .gitkeep only.
data/model-evals/*
!data/model-evals/.gitkeep
!data/model-evals/README.md

# Packaging and build artifacts
build/
dist/
# Closed-beta prototype zip. Regenerated by tools/beta/assemble.bat.
# Never commit tester files at the Git repo root.
release/
tools/portable/cache/
*.egg-info/
.eggs/
*.manifest
*.spec.bak

# Local AI / vibe-coding helpers — never publish
.cursor/
AGENTS.md
PROJECT_STATUS.md
LESSONS.md
*_LESSONS.md
*_HANDOFF.md

# IDE and OS noise
.idea/
.vscode/
*.swp
*.swo
Thumbs.db
Desktop.ini
.DS_Store

# Logs
*.log
logs/
